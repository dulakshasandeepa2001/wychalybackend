# Server Port
PORT=3000

# Zoho OAuth 2.0 Credentials
ZOHO_CLIENT_ID=your_client_id_here
ZOHO_CLIENT_SECRET=your_client_secret_here
ZOHO_REFRESH_TOKEN=your_refresh_token_here

# Zoho Books Organization ID
ZOHO_ORG_ID=your_organization_id_here

# Zoho Data Center Domains (Default is .com, change if India .in or Europe .eu)
# US: https://accounts.zoho.com | https://www.zohoapis.com/books/v3
# IN: https://accounts.zoho.in | https://www.zohoapis.in/books/v3
# EU: https://accounts.zoho.eu | https://www.zohoapis.eu/books/v3
ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
ZOHO_BOOKS_API_URL=https://www.zohoapis.com/books/v3
